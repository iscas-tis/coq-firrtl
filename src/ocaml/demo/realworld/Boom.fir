    mem_units_0.io.lsu_io <- io.lsu.exe[0]
    wire hits : UInt<1>[4]
    hits is invalid
    wire hits_1 : UInt<1>[2]
    hits_1 is invalid
    wire hits_2 : UInt<1>[6]
    hits_2 is invalid
    inst csr aof CSRFile
    csr.clock_wky <= clock_wky
    csr.reset_wky <= reset_wky
    csr.io.inst_wky[0] is invalid
    csr.io.rocc_interrupt <= io.rocc.interrupt
    wire custom_csrs : {csrs : {wen : UInt<1>, wdata : UInt<64>, value : UInt<64>}[1]}
    custom_csrs.csrs[0].value <= csr.io.customCSRs[0].value
    custom_csrs.csrs[0].wdata <= csr.io.customCSRs[0].wdata
    custom_csrs.csrs[0].wen <= csr.io.customCSRs[0].wen
    node set = bits(csr.io.counters[0].eventSel, 1, 0)
    node mask = shr(csr.io.counters[0].eventSel, 8)
    hits[0] <= rob.io.com_xcpt.valid
    hits[1] <= UInt<1>(0)
    hits[2] <= UInt<1>(0)
    hits[3] <= UInt<1>(0)
    node sets_lo = cat(hits[1], hits[0])
    node sets_hi = cat(hits[3], hits[2])
    node _sets_T = cat(sets_hi, sets_lo)
    node _sets_T_1 = and(mask, _sets_T)
    node sets_0 = orr(_sets_T_1)
    hits_1[0] <= UInt<1>(0)
    hits_1[1] <= rob.io.flush.valid
    node _sets_T_2 = cat(hits_1[1], hits_1[0])
    node _sets_T_3 = and(mask, _sets_T_2)
    node sets_1 = orr(_sets_T_3)
    hits_2[0] <= io.ifu.perf.acquire
    hits_2[1] <= io.lsu.perf.acquire
    hits_2[2] <= io.lsu.perf.release
